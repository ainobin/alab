%{
Problem 2: Signal Operations
Given x[n]={1,2,3,4}:
• Perform time shifting, scaling, and reversal 
• Plot all results
Verify mathematically
%}

clc;
clear;
close all;

% Original signal
x = [1 2 3 4];
n = 0:3;

% 1. Time Shifting (Delay by 2)
n_shift = n + 2;

% 2. Time Scaling (Amplitude Scaling by 2)
x_scale = 2 * x;

% 3. Time Reversal
x_reverse = fliplr(x);
n_reverse = -fliplr(n);

% Plotting
figure;

% Original Signal
subplot(2,2,1);
stem(n, x, 'filled');
hold on;
plot(n,x,'blue', 'LineWidth',1)
grid on;
title('Original Signal x[n]');
xlabel('n');
ylabel('Amplitude');
hold off;

% Time Shifted Signal
subplot(2,2,2);
stem(n_shift, x, 'filled');
hold on;
plot(n_shift,x, 'blue', LineWidth=1);
grid on;
title('Time Shifted Signal x[n-2]');
xlabel('n');
ylabel('Amplitude');
hold off;

% Amplitude Scaled Signal
subplot(2,2,3);
stem(n, x_scale, 'filled');
hold on;
plot(n, x_scale, 'bule', LineWidth=1);
grid on;
title('Amplitude Scaled Signal 2x[n]');
xlabel('n');
ylabel('Amplitude');
hold off;

% Time Reversed Signal
subplot(2,2,4);
stem(n_reverse, x_reverse, 'filled');
hold on;
plot(n_reverse, x_reverse, 'blue', LineWidth=1);
grid on;
title('Time Reversed Signal x[-n]');
xlabel('n');
ylabel('Amplitude');
hold off;